<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>spring-decision-layer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>spring-decision-layer</name>
	<description>The decision layer: a Spring AI advisor whose decision traces become the precedent for later decisions</description>
	<properties>
		<java.version>17</java.version>
		<spring-ai.version>2.0.0</spring-ai.version>
		<spring-shell.version>4.0.3</spring-shell.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.shell</groupId>
				<artifactId>spring-shell-dependencies</artifactId>
				<version>${spring-shell.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>

		<!-- The command line. The loan decision is a Spring Shell command rather than a
		     CommandLineRunner, so it runs only when asked for by name and never fires on its
		     own at context startup. That is what keeps a @SpringBootTest from deciding a loan
		     (and calling the model) just by booting the application. The starter pulls in JLine
		     and Boot's shell auto-configuration. -->
		<dependency>
			<groupId>org.springframework.shell</groupId>
			<artifactId>spring-shell-starter</artifactId>
		</dependency>

		<!-- The context graph. This starter contributes the Neo4j Java driver and Boot's
		     auto-configuration for it, which turns the spring.neo4j.* properties into an
		     injectable Driver bean. LoanGraph writes Cypher against that driver directly;
		     no object graph mapping layer is involved. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-neo4j</artifactId>
		</dependency>

		<!-- The transcript, kept for contrast rather than for the verdict. Spring AI's own
		     Neo4j chat memory stores the transcript in the same database as the decision
		     graph, so a reader can query both and see what each one can answer. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-chat-memory-repository-neo4j</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- LoanGraphTests runs its Cypher against a real Neo4j in a container, so the
		     traversal the example turns on is tested rather than described. Versions come
		     from the Testcontainers BOM that spring-boot-dependencies already imports. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-neo4j</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @ServiceConnection and the Neo4jContainerConnectionDetailsFactory it drives.
		     This is what lets TestApplication hand the app a throwaway Neo4j from a container
		     instead of the NEO4J_URI the .env supplies, so ./mvnw spring-boot:test-run needs
		     no external database. Only used by the test-source TestApplication. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
