# Copy to .env and fill in real values. .env is gitignored, never commit real secrets.

ANTHROPIC_API_KEY=

# Any Neo4j 5 or later: Aura, Desktop, or a local container. The demo seeds its own nodes and
# never empties anything, so pointing it at an instance that holds other work is safe.
#   docker run -p 7687:7687 -p 7474:7474 -e NEO4J_AUTH=neo4j/password neo4j:5.26
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional. Names the database the demo runs against instead of leaving it to the
# connection's home database. Leave unset to keep the previous behavior.
NEO4J_DATABASE=
